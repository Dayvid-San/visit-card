# Copie este arquivo para .env.local e preencha com os valores reais.
# Os valores ficam em Firebase Console > Configurações do projeto > Seus apps > Configuração do SDK.
# Por serem NEXT_PUBLIC_*, eles são embutidos no bundle do cliente durante o build (static export).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL base da API do Visit-Card--Backend (usada pelo formulário de contato e pela
# redefinição de senha). Sem servidor Next.js próprio (static export), o frontend
# chama esse endereço diretamente; o backend precisa liberar essa origem em
# FRONTEND_ORIGIN (ver .env.example do backend).
NEXT_PUBLIC_API_URL=http://localhost:8080
